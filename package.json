{
  "name": "@tertium/loki",
  "version": "0.1.0",
  "description": "Terminal chat CLI for local Ollama models — Claude-Code-CLI style, Node/TypeScript, no Python",
  "author": "Vitalii Balabanov",
  "email": "tertiumnon@gmail.com",
  "main": "bin/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
